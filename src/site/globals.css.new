/* Tailwind v4 — config lives here only. There is no tailwind.config.js; do not add one. */
@import "tailwindcss";

/*
 * EDITORIAL PORTFOLIO — DESIGN SYSTEM
 * Dark cinematic palette. Sharp, architectural. No rounded corners.
 * Typography: Space Grotesk (headlines) + DM Sans (UI)
 */

:root {
	color-scheme: dark;

	/* Cinematic Palette */
	--background: 0 0% 4%;
	--foreground: 30 10% 94%;
	--surface: 0 0% 7%;
	--surface-2: 0 0% 11%;
	--card: 0 0% 7%;
	--card-foreground: 30 10% 94%;

	/* Accent: Warm Gold */
	--primary: 38 45% 60%;
	--primary-foreground: 0 0% 4%;

	/* Muted / Stone */
	--secondary: 30 5% 35%;
	--secondary-foreground: 30 10% 94%;
	--muted: 0 0% 11%;
	--muted-foreground: 30 5% 52%;

	/* Accent alias */
	--accent: 38 45% 60%;
	--accent-foreground: 0 0% 4%;

	/* Utility */
	--destructive: 0 62% 50%;
	--destructive-foreground: 0 0% 98%;
	--border: 0 0% 14%;
	--border-strong: 0 0% 22%;
	--input: 0 0% 9%;
	--ring: 38 45% 60%;
	--radius: 0rem;

	/* Motion */
	--ease-cinematic: cubic-bezier(0.25, 0.1, 0.25, 1);
	--duration-slow: 600ms;
	--duration-medium: 400ms;
	--duration-fast: 200ms;
}

@theme {
	--color-background: hsl(var(--background));
	--color-foreground: hsl(var(--foreground));
	--color-surface: hsl(var(--surface));
	--color-surface-2: hsl(var(--surface-2));
	--color-card: hsl(var(--card));
	--color-card-foreground: hsl(var(--card-foreground));
	--color-primary: hsl(var(--primary));
	--color-primary-foreground: hsl(var(--primary-foreground));
	--color-secondary: hsl(var(--secondary));
	--color-secondary-foreground: hsl(var(--secondary-foreground));
	--color-muted: hsl(var(--muted));
	--color-muted-foreground: hsl(var(--muted-foreground));
	--color-accent: hsl(var(--accent));
	--color-accent-foreground: hsl(var(--accent-foreground));
	--color-destructive: hsl(var(--destructive));
	--color-destructive-foreground: hsl(var(--destructive-foreground));
	--color-border: hsl(var(--border));
	--color-border-strong: hsl(var(--border-strong));
	--color-input: hsl(var(--input));
	--color-ring: hsl(var(--ring));

	--radius-sm: 0rem;
	--radius-md: 0rem;
	--radius-lg: 0rem;

	--font-sans: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
	--font-editorial: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
	--font-mono: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
}

@layer base {
	*, *::before, *::after { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body {
		margin: 0;
		background-color: hsl(var(--background));
		color: hsl(var(--foreground));
		font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		overflow-x: hidden;
	}
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.05;
		margin: 0;
	}
	p { margin: 0; line-height: 1.65; }
	a { color: inherit; text-decoration: none; }
	img { display: block; max-width: 100%; }
	button { cursor: pointer; border: none; background: none; font-family: inherit; }
	input, textarea { font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif; }
}

/* Scroll Reveal */
.reveal {
	opacity: 0;
	transform: translateY(32px);
	transition: opacity var(--duration-slow) var(--ease-cinematic),
	            transform var(--duration-slow) var(--ease-cinematic);
}
.reveal.visible { opacity: 1; transform: translateY(0); }

.reveal-fade { opacity: 0; transition: opacity var(--duration-slow) var(--ease-cinematic); }
.reveal-fade.visible { opacity: 1; }

.reveal-left {
	opacity: 0;
	transform: translateX(-24px);
	transition: opacity var(--duration-slow) var(--ease-cinematic),
	            transform var(--duration-slow) var(--ease-cinematic);
}
.reveal-left.visible { opacity: 1; transform: translateX(0); }

.delay-100 { transition-delay: 100ms; }
.delay-200 { transition-delay: 200ms; }
.delay-300 { transition-delay: 300ms; }
.delay-400 { transition-delay: 400ms; }
.delay-500 { transition-delay: 500ms; }
.delay-600 { transition-delay: 600ms; }
.delay-700 { transition-delay: 700ms; }

/* Image Hover Zoom */
.img-zoom { overflow: hidden; }
.img-zoom img { transition: transform 700ms var(--ease-cinematic); will-change: transform; }
.img-zoom:hover img { transform: scale(1.04); }

/* Underline Reveal */
.underline-reveal { position: relative; display: inline-block; }
.underline-reveal::after {
	content: '';
	position: absolute;
	bottom: -2px;
	left: 0;
	width: 100%;
	height: 1px;
	background: currentColor;
	transform: scaleX(0);
	transform-origin: left;
	transition: transform var(--duration-medium) var(--ease-cinematic);
}
.underline-reveal:hover::after { transform: scaleX(1); }

/* Scrollbar */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: hsl(var(--background)); }
::-webkit-scrollbar-thumb { background: hsl(var(--border-strong)); }

/* Selection */
::selection { background: hsl(var(--primary) / 0.25); color: hsl(var(--foreground)); }
